# ── App ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex-string

# UI login password
ADMIN_PASSWORD=replace-with-strong-password

# Programmatic admin API access (X-Admin-Key header)
ADMIN_API_KEY=replace-with-another-strong-secret

# ── Database ─────────────────────────────────────────────────────────────────
# Railway provides DATABASE_URL automatically for the linked Postgres service
# Format is automatically converted from postgres:// to postgresql+asyncpg://
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Ollama ───────────────────────────────────────────────────────────────────
# Use Railway private networking: http://<ollama-service>.railway.internal:11434
OLLAMA_URL=http://localhost:11434

# Default model served when clients don't specify one
DEFAULT_MODEL=gemma4:e2b

# ── Rate limiting defaults (per new key) ─────────────────────────────────────
DEFAULT_RPM=60
DEFAULT_RPD=1000
